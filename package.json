{
  "name": "canvasly",
  "version": "0.1.0-beta.3",
  "private": true,
  "description": "A visual AI workspace for discussing ideas, editing real HTML, and shipping together.",
  "author": "KevinYoung23 and Canvasly contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/KevinYoung23/Canvasly.git"
  },
  "homepage": "https://github.com/KevinYoung23/Canvasly#readme",
  "keywords": [
    "ai",
    "html-editor",
    "visual-editor",
    "cowork",
    "agent",
    "nextjs"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "ALLOW_PRIVATE_LLM_ENDPOINTS=true WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "node scripts/start-local.mjs",
    "copilot:bridge": "node tools/copilot-bridge.mjs",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:build": "node desktop/build.mjs",
    "desktop:bundle": "node desktop/bundle.mjs",
    "desktop:pack": "npm run desktop:build && npm run desktop:bundle && node desktop/package.mjs --dir",
    "desktop:dist": "npm run desktop:build && npm run desktop:bundle && node desktop/package.mjs",
    "desktop:dist:mac": "npm run desktop:build && npm run desktop:bundle && node desktop/package.mjs --mac --universal --publish=never",
    "desktop:dist:win": "npm run desktop:build && npm run desktop:bundle && node desktop/package.mjs --win --x64 --publish=never",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/desktop-runtime.test.mjs tests/stream-client.test.mjs tests/stream-api.unit.test.mjs",
    "test:stream": "node --experimental-strip-types --test tests/stream-client.test.mjs tests/stream-api.unit.test.mjs",
    "test:desktop": "node --test tests/desktop-runtime.test.mjs",
    "test:desktop-app": "npm run desktop:build && node --test tests/desktop-app.e2e.mjs",
    "test:api": "node --test --test-concurrency=1 tests/transform-api.e2e.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser.e2e.mjs",
    "test:model": "node --experimental-strip-types --test --test-concurrency=1 tests/local-model.e2e.mjs tests/local-stream.e2e.mjs",
    "test:e2e": "npm run test:api && npm run test:browser && npm run test:model",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.9",
    "drizzle-orm": "0.45.2",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electron/asar": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright-core": "^1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  },
  "main": "desktop/main.mjs",
  "type": "module",
  "displayName": "Canvasly AI HTML Editor"
}
