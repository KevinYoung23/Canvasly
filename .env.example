# Canvasly web server
CANVASLY_PORT=4173

# This Compose stack binds Canvasly to 127.0.0.1, so trusted host and LAN models
# are enabled by default. Set false before exposing Canvasly beyond this machine.
ALLOW_PRIVATE_LLM_ENDPOINTS=true

# Optional GitHub Copilot bridge
COPILOT_BRIDGE_PORT=4141
COPILOT_BRIDGE_API_KEY=
COPILOT_GITHUB_TOKEN=