# Canvasly web server
CANVASLY_PORT=4173

# Keep disabled for public deployments. Enable only when Canvasly must reach a
# trusted model or bridge on localhost, the Docker host, or a private network.
ALLOW_PRIVATE_LLM_ENDPOINTS=false

# Optional GitHub Copilot bridge
COPILOT_BRIDGE_PORT=4141
COPILOT_BRIDGE_API_KEY=
COPILOT_GITHUB_TOKEN=